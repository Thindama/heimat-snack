<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Heimat Snack</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #080706;
      --fg: #E8E2D8;
      --dim: #6B6560;
      --accent: #D44A1A;
      --gold: #B89650;
      --card: #111110;
      --line: rgba(232,226,216,0.06);
      --serif: 'Instrument Serif', Georgia, serif;
      --sans: 'Space Grotesk', system-ui, sans-serif;
    }
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    html{overflow-x:hidden;scroll-behavior:auto}
    body{font-family:var(--sans);background:var(--bg);color:var(--fg);overflow-x:hidden;-webkit-font-smoothing:antialiased}
    img{display:block;width:100%;height:100%;object-fit:cover}
    ::selection{background:var(--accent);color:#fff}

    /* Grain */
    body::after{content:'';position:fixed;inset:0;z-index:9999;pointer-events:none;opacity:0.025;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}

    /* Smooth scroll feel */
    html{scroll-behavior:smooth}

    /* Progress */
    #prog{position:fixed;top:0;left:0;height:2px;background:var(--accent);z-index:10001;width:0;transform-origin:left}

    /* Custom cursor */
    #cur{position:fixed;width:12px;height:12px;background:var(--accent);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:width .3s,height .3s,opacity .3s,background .3s;mix-blend-mode:exclusion}
    #cur.big{width:80px;height:80px;background:transparent;border:1px solid var(--fg);mix-blend-mode:normal}

    /* ────── UTILITY ────── */
    .abs{position:absolute}.rel{position:relative}.z1{z-index:1}.z2{z-index:2}.z3{z-index:3}
    .full{width:100%;height:100%}
    .flex{display:flex}.col{flex-direction:column}.center{align-items:center;justify-content:center}
    .between{justify-content:space-between}

    /* ────── ANIMATIONS ────── */
    .a-up{opacity:0;transform:translateY(100px)}.a-up.on{opacity:1;transform:none;transition:all 1s cubic-bezier(.22,1,.36,1)}
    .a-left{opacity:0;transform:translateX(-100px)}.a-left.on{opacity:1;transform:none;transition:all 1s cubic-bezier(.22,1,.36,1)}
    .a-right{opacity:0;transform:translateX(100px)}.a-right.on{opacity:1;transform:none;transition:all 1s cubic-bezier(.22,1,.36,1)}
    .a-scale{opacity:0;transform:scale(.85)}.a-scale.on{opacity:1;transform:none;transition:all 1.2s cubic-bezier(.22,1,.36,1)}
    .a-clip{clip-path:polygon(0 0,0 0,0 100%,0 100%)}.a-clip.on{clip-path:polygon(0 0,100% 0,100% 100%,0 100%);transition:clip-path 1.4s cubic-bezier(.22,1,.36,1)}
    .a-clip-up{clip-path:inset(100% 0 0 0)}.a-clip-up.on{clip-path:inset(0);transition:clip-path 1.2s cubic-bezier(.22,1,.36,1)}
    .d1{transition-delay:.1s!important}.d2{transition-delay:.2s!important}.d3{transition-delay:.3s!important}.d4{transition-delay:.4s!important}.d5{transition-delay:.5s!important}

    /* Parallax via JS */
    [data-speed]{will-change:transform}

    /* ══════════════════════════════════════
       NAV — Minimal
    ══════════════════════════════════════ */
    nav{position:fixed;top:0;left:0;right:0;z-index:1000;padding:1.2rem 2rem;display:flex;justify-content:space-between;align-items:center;transition:all .5s}
    nav.s{background:rgba(8,7,6,.9);backdrop-filter:blur(30px);padding:.7rem 2rem;border-bottom:1px solid var(--line)}
    nav .logo img{height:44px;width:auto;object-fit:contain;transition:height .4s}
    nav.s .logo img{height:34px}
    .n-links{display:flex;gap:2rem;list-style:none;align-items:center}
    .n-links a{text-decoration:none;color:var(--dim);font-size:.8rem;font-weight:500;letter-spacing:.5px;transition:color .3s}
    .n-links a:hover{color:var(--fg)}
    .n-cta{color:var(--fg)!important;border:1px solid var(--line);padding:.5rem 1.3rem;border-radius:100px;transition:all .3s!important}
    .n-cta:hover{background:var(--accent)!important;border-color:var(--accent)!important;color:#fff!important}
    .n-tog{display:none;background:none;border:none;cursor:pointer;flex-direction:column;gap:5px}
    .n-tog span{width:22px;height:1.5px;background:var(--fg)}

    /* ══════════════════════════════════════
       HERO — Immersive fullscreen
    ══════════════════════════════════════ */
    .hero{height:100vh;position:relative;overflow:hidden}
    .hero-media{position:absolute;inset:0}
    .hero-media img{animation:slowZoom 25s ease-in-out infinite alternate}
    @keyframes slowZoom{0%{transform:scale(1) translate(0,0)}100%{transform:scale(1.15) translate(-1%,1%)}}
    .hero-grad{position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,7,6,.3) 0%,rgba(8,7,6,.15) 30%,rgba(8,7,6,.6) 70%,rgba(8,7,6,.97) 100%)}
    .hero-inner{position:absolute;bottom:0;left:0;right:0;padding:0 3rem 3rem;z-index:3}
    .hero-top{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem}
    .hero-title{flex:1}
    .hero-logo{width:200px;height:auto;object-fit:contain;margin-bottom:1.5rem;filter:drop-shadow(0 4px 20px rgba(0,0,0,.5));opacity:0;animation:hUp .8s .2s forwards}
    .hero h1{font-family:var(--serif);font-size:clamp(3.5rem,8vw,8rem);line-height:.92;letter-spacing:-.03em;font-weight:400}
    .hero h1 em{font-style:italic;color:var(--accent)}
    .hero h1 .w{display:inline-block;overflow:hidden;vertical-align:bottom}
    .hero h1 .w span{display:inline-block;opacity:0;transform:translateY(110%);animation:hSlide .7s forwards}
    .hero h1 .w:nth-child(1) span{animation-delay:.3s}
    .hero h1 .w:nth-child(2) span{animation-delay:.4s}
    .hero h1 .w:nth-child(3) span{animation-delay:.5s}
    .hero h1 .w:nth-child(4) span{animation-delay:.6s}
    @keyframes hSlide{to{opacity:1;transform:none}}
    @keyframes hUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
    .hero-meta{opacity:0;animation:hUp .8s .8s forwards;display:flex;flex-direction:column;align-items:flex-end;gap:.5rem;min-width:200px}
    .hero-label{font-size:.65rem;font-weight:600;letter-spacing:4px;text-transform:uppercase;color:var(--gold)}
    .hero-desc{font-size:.85rem;color:var(--dim);text-align:right;line-height:1.6;max-width:260px}
    .hero-bar{margin-top:2rem;display:flex;gap:0;border-top:1px solid var(--line);opacity:0;animation:hUp .8s 1s forwards}
    .hero-bar-item{flex:1;padding:1.2rem 0;border-right:1px solid var(--line);text-align:center}
    .hero-bar-item:last-child{border-right:none}
    .hero-bar-num{font-family:var(--serif);font-size:2rem;line-height:1}
    .hero-bar-num small{font-size:1rem;color:var(--gold)}
    .hero-bar-txt{font-size:.6rem;color:var(--dim);letter-spacing:2px;text-transform:uppercase;margin-top:.3rem}

    /* ══════════════════════════════════════
       MARQUEE
    ══════════════════════════════════════ */
    .mq{overflow:hidden;padding:.6rem 0;border-bottom:1px solid var(--line)}
    .mq-track{display:flex;animation:mq 50s linear infinite;width:max-content}
    .mq-i{display:flex;align-items:center;gap:1.5rem;padding:0 1.5rem;white-space:nowrap;font-size:.65rem;letter-spacing:4px;text-transform:uppercase;color:rgba(232,226,216,.12);font-weight:600}
    .mq-dot{width:3px;height:3px;border-radius:50%;background:var(--gold)}
    .mq-img{width:44px;height:28px;border-radius:2px;object-fit:cover;opacity:.25}
    @keyframes mq{to{transform:translateX(-50%)}}

    /* ══════════════════════════════════════
       BIG TEXT + IMAGE OVERLAP
    ══════════════════════════════════════ */
    .overlap{display:grid;grid-template-columns:1fr 1fr;min-height:90vh;position:relative}
    .overlap-text{padding:4rem 3rem;display:flex;flex-direction:column;justify-content:center;position:relative;z-index:2}
    .overlap-text .tag{font-size:.6rem;letter-spacing:5px;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:1rem}
    .overlap-text h2{font-family:var(--serif);font-size:clamp(2.5rem,4.5vw,4.5rem);line-height:1.05;letter-spacing:-.02em;margin-bottom:1.5rem;font-weight:400}
    .overlap-text p{font-size:.9rem;line-height:1.85;color:var(--dim);max-width:420px}
    .overlap-text .quote{margin-top:2rem;padding:1.2rem 1.5rem;border-left:2px solid var(--accent);font-family:var(--serif);font-style:italic;font-size:1.05rem;color:var(--fg);line-height:1.5}
    .overlap-text .sig{margin-top:1.5rem;display:flex;align-items:center;gap:.8rem;font-size:.75rem;color:var(--gold);letter-spacing:1px}
    .overlap-text .sig::before{content:'';width:25px;height:1px;background:var(--accent)}
    .overlap-img{position:relative;overflow:hidden}
    .overlap-img img{transition:transform 1s cubic-bezier(.22,1,.36,1)}
    .overlap-img:hover img{transform:scale(1.04)}
    /* Floating stat over image */
    .float-stat{position:absolute;bottom:2rem;left:-60px;z-index:3;background:var(--accent);padding:1.5rem 2rem;border-radius:4px}
    .float-stat-num{font-family:var(--serif);font-size:2.5rem;color:#fff;line-height:1}
    .float-stat-txt{font-size:.6rem;color:rgba(255,255,255,.7);letter-spacing:2px;text-transform:uppercase;margin-top:.3rem}

    /* ══════════════════════════════════════
       HORIZONTAL SCROLL MENU
    ══════════════════════════════════════ */
    .hmenu{position:relative;padding:3rem 0 2rem;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .hmenu-head{padding:0 3rem;display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2rem}
    .hmenu-head h2{font-family:var(--serif);font-size:clamp(2rem,4vw,3.5rem);font-weight:400;letter-spacing:-.02em}
    .hmenu-hint{font-size:.65rem;color:var(--dim);letter-spacing:3px;text-transform:uppercase;display:flex;align-items:center;gap:.8rem}
    .hmenu-hint::after{content:'';width:40px;height:1px;background:var(--dim)}
    .hmenu-track{display:flex;gap:.8rem;overflow-x:auto;padding:0 3rem 1.5rem;scroll-snap-type:x mandatory;scrollbar-width:none}
    .hmenu-track::-webkit-scrollbar{display:none}
    .mc{flex:0 0 320px;scroll-snap-align:start;background:var(--card);border:1px solid var(--line);border-radius:6px;overflow:hidden;transition:all .5s cubic-bezier(.22,1,.36,1);cursor:pointer}
    .mc:hover{transform:translateY(-8px) scale(1.01);border-color:rgba(212,74,26,.2);box-shadow:0 30px 80px rgba(0,0,0,.4)}
    .mc-img{height:200px;overflow:hidden;position:relative}
    .mc-img img{transition:transform .7s cubic-bezier(.22,1,.36,1)}
    .mc:hover .mc-img img{transform:scale(1.1)}
    .mc-badge{position:absolute;top:.6rem;left:.6rem;background:var(--accent);color:#fff;font-size:.55rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;padding:.25rem .6rem;border-radius:2px}
    .mc-body{padding:1.2rem 1.3rem}
    .mc-row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:.3rem}
    .mc-body h3{font-family:var(--serif);font-size:1.1rem;font-weight:400}
    .mc-price{font-family:var(--serif);font-size:1rem;color:var(--accent)}
    .mc-body p{font-size:.78rem;color:var(--dim);line-height:1.6}
    .mc-line{width:20px;height:1px;background:var(--line);margin-top:.8rem;transition:width .4s,background .4s}
    .mc:hover .mc-line{width:40px;background:var(--accent)}

    /* ══════════════════════════════════════
       FULLBLEED PARALLAX IMAGE
    ══════════════════════════════════════ */
    .fb{position:relative;height:80vh;overflow:hidden}
    .fb img{position:absolute;inset:-15% 0;height:130%;object-fit:cover}
    .fb-over{position:absolute;inset:0;background:rgba(8,7,6,.55);display:flex;align-items:center;justify-content:center}
    .fb-txt{text-align:center;max-width:600px;padding:2rem}
    .fb-txt .big{font-family:var(--serif);font-size:clamp(1.8rem,3.5vw,3rem);line-height:1.3;font-weight:400;font-style:italic;margin-bottom:1rem}
    .fb-txt cite{font-style:normal;font-size:.7rem;color:var(--gold);letter-spacing:3px;text-transform:uppercase}

    /* ══════════════════════════════════════
       FEATURES — Full-width strip, no gaps
    ══════════════════════════════════════ */
    .fstrip{display:grid;grid-template-columns:repeat(4,1fr)}
    .fstrip-i{padding:2.5rem 2rem;text-align:center;border-right:1px solid var(--line);border-bottom:1px solid var(--line);transition:background .5s}
    .fstrip-i:last-child{border-right:none}
    .fstrip-i:hover{background:rgba(212,74,26,.04)}
    .fstrip-i .ico{font-size:1.6rem;margin-bottom:.8rem}
    .fstrip-i h3{font-family:var(--serif);font-size:1rem;margin-bottom:.4rem;font-weight:400}
    .fstrip-i p{font-size:.72rem;color:var(--dim);line-height:1.6}

    /* ══════════════════════════════════════
       DENSE GALLERY — Edge to edge
    ══════════════════════════════════════ */
    .gal{display:grid;grid-template-columns:repeat(5,1fr);grid-auto-rows:240px;gap:3px}
    .gal-i{overflow:hidden;position:relative;cursor:pointer}
    .gal-i img{transition:transform .8s cubic-bezier(.22,1,.36,1)}
    .gal-i:hover img{transform:scale(1.12)}
    .gal-i::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(8,7,6,.4),transparent 50%);opacity:0;transition:opacity .4s}
    .gal-i:hover::after{opacity:1}
    .gal-i span{position:absolute;bottom:.8rem;left:1rem;font-size:.7rem;font-weight:600;letter-spacing:1px;color:#fff;z-index:2;opacity:0;transform:translateY(6px);transition:all .4s}
    .gal-i:hover span{opacity:1;transform:none}
    .gal-i:nth-child(1){grid-column:span 2;grid-row:span 2}
    .gal-i:nth-child(4){grid-column:span 2}
    .gal-i:nth-child(7){grid-column:span 2}

    /* ══════════════════════════════════════
       DUAL — Split image + dark text
    ══════════════════════════════════════ */
    .dual{display:grid;grid-template-columns:1fr 1fr;min-height:70vh}
    .dual-img{overflow:hidden;position:relative}
    .dual-img img{transition:transform 1s cubic-bezier(.22,1,.36,1)}
    .dual-img:hover img{transform:scale(1.04)}
    .dual-txt{padding:4rem;display:flex;flex-direction:column;justify-content:center;background:var(--card)}
    .dual-txt h2{font-family:var(--serif);font-size:clamp(1.5rem,2.5vw,2.2rem);line-height:1.2;font-weight:400;margin-bottom:1.2rem}
    .dual-txt p{font-size:.85rem;line-height:1.8;color:var(--dim)}
    .dual-list{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-top:1.2rem}
    .dual-list li{font-size:.78rem;color:rgba(232,226,216,.45);display:flex;align-items:center;gap:.5rem}
    .dual-list li::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--gold);flex-shrink:0}

    /* ══════════════════════════════════════
       REVIEWS — Cards
    ══════════════════════════════════════ */
    .revs{padding:4rem 3rem;display:grid;grid-template-columns:1fr 2.2fr;gap:3rem;max-width:1400px;margin:0 auto}
    .revs-left{position:sticky;top:100px}
    .revs-left h2{font-family:var(--serif);font-size:clamp(1.8rem,3vw,2.8rem);font-weight:400;margin-bottom:.8rem}
    .revs-left p{font-size:.82rem;color:var(--dim);line-height:1.7}
    .revs-score{margin-top:1.5rem}
    .revs-score .num{font-family:var(--serif);font-size:4rem;line-height:1}
    .revs-score .stars{color:var(--gold);font-size:.85rem;letter-spacing:3px;margin-top:.3rem}
    .revs-score .ct{font-size:.7rem;color:var(--dim);margin-top:.3rem}
    .revs-right{display:flex;flex-direction:column;gap:.6rem}
    .rv{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:1.8rem 2rem;transition:all .4s}
    .rv:hover{transform:translateX(6px);border-color:rgba(232,226,216,.1)}
    .rv .stars{color:var(--gold);font-size:.75rem;letter-spacing:3px;margin-bottom:.8rem}
    .rv p{font-size:.88rem;line-height:1.7;color:rgba(232,226,216,.5);font-style:italic;margin-bottom:1rem}
    .rv-who{display:flex;align-items:center;gap:.8rem;border-top:1px solid var(--line);padding-top:1rem}
    .rv-av{width:34px;height:34px;border-radius:50%;background:rgba(232,226,216,.04);display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:700;color:var(--gold)}
    .rv-name{font-size:.8rem;font-weight:600}
    .rv-role{font-size:.65rem;color:var(--dim)}

    /* ══════════════════════════════════════
       CONTACT — Split
    ══════════════════════════════════════ */
    .contact{display:grid;grid-template-columns:1fr 1fr}
    .contact-img{overflow:hidden;min-height:550px;position:relative}
    .contact-body{padding:3.5rem;background:var(--card);display:flex;flex-direction:column;justify-content:center}
    .contact-body h2{font-family:var(--serif);font-size:clamp(1.6rem,2.5vw,2.2rem);font-weight:400;margin-bottom:.5rem}
    .contact-body>p{font-size:.8rem;color:var(--dim);margin-bottom:2rem}
    .c-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
    .c-item h4{font-size:.6rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:.3rem}
    .c-item p{font-size:.88rem;line-height:1.5}
    .c-hours{margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--line)}
    .c-hours h3{font-family:var(--serif);font-size:1rem;font-weight:400;margin-bottom:1rem}
    .c-hr{display:flex;justify-content:space-between;padding:.4rem 0;font-size:.8rem;border-bottom:1px solid var(--line)}
    .c-hr:last-child{border-bottom:none}
    .c-day{color:var(--dim)}
    .c-time{font-weight:600}
    .c-time.off{color:var(--accent)}

    /* ══════════════════════════════════════
       FOOTER — Minimal
    ══════════════════════════════════════ */
    footer{padding:2rem 3rem;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;font-size:.68rem;color:var(--dim)}
    footer a{color:var(--dim);text-decoration:none;transition:color .3s}
    footer a:hover{color:var(--fg)}
    .f-links{display:flex;gap:1.5rem}

    /* ══════════════════════════════════════
       RESPONSIVE
    ══════════════════════════════════════ */
    @media(max-width:1024px){
      .overlap{grid-template-columns:1fr;min-height:auto}
      .overlap-img{min-height:50vh}
      .float-stat{left:1rem;bottom:1rem}
      .fstrip{grid-template-columns:1fr 1fr}
      .gal{grid-template-columns:repeat(3,1fr);grid-auto-rows:180px}
      .gal-i:nth-child(1){grid-column:span 2}
      .gal-i:nth-child(4){grid-column:span 1}
      .gal-i:nth-child(7){grid-column:span 1}
      .dual{grid-template-columns:1fr}
      .dual-txt{padding:3rem 2rem}
      .revs{grid-template-columns:1fr}
      .revs-left{position:static}
      .contact{grid-template-columns:1fr}
      .contact-img{min-height:300px}
    }
    @media(max-width:768px){
      nav{padding:.8rem 1.2rem}
      .n-links{display:none}
      .n-tog{display:flex}
      .n-links.open{display:flex;position:absolute;top:100%;left:0;right:0;flex-direction:column;background:rgba(8,7,6,.97);backdrop-filter:blur(20px);padding:1.5rem 2rem;gap:1rem;border-bottom:1px solid var(--line)}
      .hero-inner{padding:0 1.5rem 2rem}
      .hero-top{flex-direction:column;align-items:flex-start}
      .hero-meta{align-items:flex-start}
      .hero-desc{text-align:left}
      .hero h1{font-size:clamp(2.8rem,12vw,5rem)}
      .hero-logo{width:140px}
      .overlap-text{padding:3rem 1.5rem}
      .hmenu-head{padding:0 1.5rem}
      .hmenu-track{padding:0 1.5rem 1.5rem}
      .mc{flex:0 0 270px}
      .fstrip{grid-template-columns:1fr}
      .fstrip-i{border-right:none}
      .gal{grid-template-columns:1fr 1fr;grid-auto-rows:160px}
      .gal-i:nth-child(1){grid-column:span 2;grid-row:span 1}
      .revs{padding:3rem 1.5rem}
      .contact-body{padding:2.5rem 1.5rem}
      .c-grid{grid-template-columns:1fr}
      footer{flex-direction:column;gap:.8rem;text-align:center;padding:1.5rem}
      .hero-bar{flex-wrap:wrap}
      .hero-bar-item{flex:1 1 50%}
      #cur{display:none}
      .dual-list{grid-template-columns:1fr}
    }
    @media(max-width:480px){
      .hero-bar-item{flex:1 1 100%;border-right:none;border-bottom:1px solid var(--line)}
      .gal{grid-template-columns:1fr;grid-auto-rows:200px}
