<script>
(function(){
  const nav=document.getElementById('nav'),cur=document.getElementById('cur'),prog=document.getElementById('prog');

  // ── SCROLL ENGINE ──
  let raf,sy=0;
  function onScroll(){
    const y=window.scrollY,h=document.documentElement.scrollHeight-window.innerHeight;
    if(h>0)prog.style.width=(y/h*100)+'%';
    nav.classList.toggle('s',y>50);
    // Parallax elements
    document.querySelectorAll('[data-speed]').forEach(el=>{
      const r=el.getBoundingClientRect();
      const spd=parseFloat(el.dataset.speed);
      el.style.transform='translateY('+(r.top*spd*-1)+'px)';
    });
    // Fullbleed image
    const fb=document.getElementById('fbImg');
    if(fb){const r=fb.closest('.fb').getBoundingClientRect();fb.style.transform='translateY('+(r.top*.15)+'px)'}
  }
  let tick=false;
  window.addEventListener('scroll',()=>{if(!tick){requestAnimationFrame(()=>{onScroll();tick=false});tick=true}});

  // ── CURSOR ──
  if(window.matchMedia('(pointer:fine)').matches&&cur){
    let cx=0,cy=0,dx=0,dy=0;
    document.addEventListener('mousemove',e=>{dx=e.clientX;dy=e.clientY});
    (function mv(){cx+=(dx-cx)*.12;cy+=(dy-cy)*.12;cur.style.left=cx+'px';cur.style.top=cy+'px';requestAnimationFrame(mv)})();
    document.querySelectorAll('a,button,.mc,.gal-i,.rv').forEach(el=>{
      el.addEventListener('mouseenter',()=>cur.classList.add('big'));
      el.addEventListener('mouseleave',()=>cur.classList.remove('big'));
    });
  }

  // ── MOBILE NAV ──
  document.getElementById('nTog').addEventListener('click',()=>document.getElementById('nLinks').classList.toggle('open'));
  document.querySelectorAll('.n-links a').forEach(a=>a.addEventListener('click',()=>document.getElementById('nLinks').classList.remove('open')));

  // ── SMOOTH SCROLL ──
  document.querySelectorAll('a[href^="#"]').forEach(a=>{
    a.addEventListener('click',function(e){e.preventDefault();const t=document.querySelector(this.getAttribute('href'));if(t)t.scrollIntoView({behavior:'smooth',block:'start'})});
  });

  // ── INTERSECTION OBSERVER — Trigger animations ──
  const obs=new IntersectionObserver(entries=>{
    entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target)}});
  },{threshold:.08,rootMargin:'0px 0px -30px 0px'});
  document.querySelectorAll('.a-up,.a-left,.a-right,.a-scale,.a-clip,.a-clip-up').forEach(el=>obs.observe(el));

  // ── COUNTERS ──
  const cobs=new IntersectionObserver(entries=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        const el=e.target,t=+el.dataset.t,dur=1800,st=performance.now();
        (function run(now){const p=Math.min((now-st)/dur,1);el.textContent=Math.round(t*(1-Math.pow(1-p,4)));if(p<1)requestAnimationFrame(run)})(st);
        cobs.unobserve(el);
      }
    });
  },{threshold:.5});
  document.querySelectorAll('.ctr').forEach(c=>cobs.observe(c));

  // ── CARD TILT ──
  document.querySelectorAll('.mc').forEach(c=>{
    c.addEventListener('mousemove',e=>{
      const r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
      c.style.transform='perspective(600px) rotateX('+(y*-5)+'deg) rotateY('+(x*5)+'deg) translateY(-8px)';
    });
    c.addEventListener('mouseleave',()=>{c.style.transform=''});
  });

  // ── GALLERY DEPTH ──
  document.querySelectorAll('.gal-i').forEach(g=>{
    g.addEventListener('mousemove',e=>{
      const r=g.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
      g.querySelector('img').style.transform='scale(1.12) translate('+(x*-8)+'px,'+(y*-8)+'px)';
    });
    g.addEventListener('mouseleave',()=>{g.querySelector('img').style.transform=''});
  });

  // ── SMOOTH CURSOR ON CURSOR ──
  // Already handled above with lerp

  // ── FADE IN ──
  document.body.style.opacity='0';document.body.style.transition='opacity .4s';
  window.addEventListener('load',()=>{document.body.style.opacity='1'});

})();
</script>
